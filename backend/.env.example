# Canvas-aware POC: deAPI Qwen edit (needs DEAPI_API_KEY)
IMAGE_PROVIDER=deapi-edit
DEAPI_API_KEY=
DEAPI_EDIT_MODEL=QwenImageEdit_Plus_NF4
DEAPI_EDIT_STEPS=20

# Facilitator credit metering (off by default)
CREDITS_ENABLED=false
CREDITS_DEFAULT_BALANCE=20

# Shape-first Ask Mode (shape_llm needs GOOGLE_API_KEY; mock is offline stub)
BOARD_SUGGEST_PROVIDER=shape_llm
BOARD_SUGGEST_MODEL=gemini-3.1-flash-lite

GOOGLE_API_KEY=
ADMIN_ACCESS=true

# Local STT (faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Fallbacks
# IMAGE_PROVIDER=local-diagram
# IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=

# Paid Nano Banana (needs billing for image quota)
# IMAGE_PROVIDER=gemini-image

SUPABASE_URL=
SUPABASE_KEY=

FAL_KEY=
OPENAI_API_KEY=
