# Free local mode (default) — no Google key required for diagrams or speech
IMAGE_PROVIDER=local-diagram
GOOGLE_API_KEY=
ADMIN_ACCESS=true

# Local STT (faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Smarter diagrams (needs https://aistudio.google.com/apikey)
# IMAGE_PROVIDER=svg-llm
# GOOGLE_API_KEY=your_key_here

# Optional free alternative: pollinations
# IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=

# Paid upgrade (Nano Banana)
# IMAGE_PROVIDER=gemini-image

# Leave empty for free local mode (skips persistence / icons)
SUPABASE_URL=
SUPABASE_KEY=

FAL_KEY=
OPENAI_API_KEY=
